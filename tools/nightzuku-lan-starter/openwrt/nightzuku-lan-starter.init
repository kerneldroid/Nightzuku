#!/bin/sh /etc/rc.common
# OpenWrt procd init script for nightzuku-lan-starter

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/nightzuku-lan-starter
ADB_BIN=/usr/bin/adb

start_service() {
    procd_open_instance
    procd_set_param command "$PROG" --adb "$ADB_BIN"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
